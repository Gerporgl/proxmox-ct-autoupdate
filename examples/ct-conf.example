# Opt-in block for a Proxmox container config (/etc/pve/lxc/<CTID>.conf).
#
# Easiest way: container -> Summary tab in the Proxmox UI, and type it WITHOUT the
# '#' characters:
#
#     ```
#     AutoUpdate=registry
#     Image=registry.example.com/org/app:latest
#     ```
#
# Proxmox stores the summary as comment lines, which is the form shown below.
# Every line must start with '#', the block must be fenced by exactly a pair of
# ``` lines (```md also works). Other summary text is ignored.

#```
#AutoUpdate=registry
#Image=registry.example.com/org/app%3Alatest
#```

# %3A is the URL encoded form of ':' — both forms work:
#   #Image=registry.example.com/org/app:latest
#
# The tag is mandatory (no tag => the container is skipped).
#
# Optional keys (inside the block):
#   SnapshotKeep=0      keep N past snapshots for this container
#
# Unknown keys are ignored. AutoUpdate must be exactly "registry".

arch: amd64
cores: 4
hostname: ctauto-demo
memory: 4096
net0: name=eth0,bridge=vmbr0,ip=dhcp,type=veth
ostype: ubuntu
# A second volume bound over /root: Proxmox keeps that rootfs directory empty (and
# vzdump needs it that way), so after an update the image's own /root/.bashrc and
# friends are deleted again by the updater. Nothing under this mount is ever touched.
mp0: local-zfs:subvol-100-disk-1,mp=/root,size=8G
rootfs: local-zfs:subvol-100-disk-0,size=16G
swap: 0
unprivileged: 1
